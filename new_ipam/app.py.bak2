    # ==================== API - 系统 ====================
    
    @app.route("/api/system/configs", methods=["GET"])
    @login_required
    @permission_required("system:read")
    def api_get_system_configs():
        """获取系统配置"""
        conn = get_db()
        cursor = conn.cursor() if conn.__class__.__name__ == 'Connection' else conn
        results = cursor.execute("SELECT * FROM system_config ORDER BY config_key").fetchall()
        conn.close()
        return jsonify({"ok": True, "configs": [dict(r) for r in results]})
    
    @app.route("/api/system/configs", methods=["POST"])
    @login_required
    @permission_required("system:write")
    def api_add_system_config():
        """添加系统配置"""
        data = request.get_json() or request.form
        key = data.get("config_key", "")
        value = data.get("config_value", "")
        if not key:
            return jsonify({"ok": False, "message": "配置键不能为空"}), 400
        try:
            create_system_config(key, value)
            return jsonify({"ok": True, "message": "配置已添加"})
        except Exception as e:
            return jsonify({"ok": False, "message": f"操作失败: {e}"}), 500
    
    @app.route("/api/system/configs/<key>", methods=["PUT"])
    @login_required
    @permission_required("system:write")
    def api_update_system_config(key: str):
        """更新系统配置"""
        data = request.get_json() or request.form
        value = data.get("config_value", "")
        if not update_system_config(key, value):
            return jsonify({"ok": False, "message": "配置不存在"}), 404
        return jsonify({"ok": True, "message": "配置已更新"})
    
    @app.route("/api/system/configs/<key>", methods=["DELETE"])
    @login_required
    @permission_required("system:write")
    def api_delete_system_config(key: str):
        """删除系统配置"""
        if not delete_system_config(key):
            return jsonify({"ok": False, "message": "配置不存在"}), 404
        return jsonify({"ok": True, "message": "配置已删除"})
    
    @app.route("/api/system/backup", methods=["POST"])
    @login_required
    @permission_required("backup:execute")
    def api_backup_database():
        """备份数据库"""
        try:
            from utils import backup_database
            backup_path = backup_database()
            return jsonify({"ok": True, "message": "备份成功", "backup_path": str(backup_path)})
        except Exception as e:
            return jsonify({"ok": False, "message": f"备份失败: {e}"}), 500
    
    @app.route("/api/system/restore", methods=["POST"])
    @login_required
    @permission_required("backup:execute")
    def api_restore_database():
        """恢复数据库"""
        try:
            from utils import restore_database
            backup_path = request.files.get("file")
            if not backup_path:
                return jsonify({"ok": False, "message": "请选择备份文件"}), 400
            
            from config import DATA_DIR
            from utils import sanitize_filename
            backup_file = DATA_DIR / f"restore_{sanitize_filename(backup_path.filename)}"
            backup_path.save(backup_file)
            ok = restore_database(backup_file)
            backup_file.unlink()
            if ok:
                return jsonify({"ok": True, "message": "恢复成功"})
            return jsonify({"ok": False, "message": "恢复失败"}), 400
        except Exception as e:
            return jsonify({"ok": False, "message": f"恢复失败: {e}"}), 500
    
    @app.route("/api/system/health", methods=["GET"])
    @login_required
    def api_system_health():
        """系统健康检查"""
        return jsonify({"ok": True, "status": "healthy", "database": DB_TYPE, "db_path": str(DB_PATH)})
    
    @app.errorhandler(404)
    def handle_404(error):
        if request.path.startswith("/api/"):
            return jsonify({"ok": False, "message": "404 未找到请求的资源"}), 404
        return render_template("404.html"), 404


if __name__ == "__main__":
    app = create_app()
    app.run(host=HOST, port=PORT, debug=DEBUG)
