    @app.route("/api/bindings", methods=["GET"])
    @login_required
    def api_get_bindings():
        """获取 IP-MAC 绑定列表"""
        page = request.args.get("page", 1, type=int)
        per_page = request.args.get("per_page", 50, type=int)
        search = request.args.get("search", "")
        switch_id = request.args.get("switch_id", None, type=int)
        status = request.args.get("status", "")
        vlan = request.args.get("vlan", None, type=int)
        
        bindings, total = get_bindings(page, per_page, search, switch_id, status, vlan)
        return jsonify({"ok": True, "bindings": bindings, "total": total, "page": page, "per_page": per_page})
    
