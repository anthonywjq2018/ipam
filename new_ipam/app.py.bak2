logger = None
try:
    from utils.logger import logger
except Exception:
    pass


def create_app():
    """创建 Flask 应用"""
    app = Flask(__name__, template_folder="templates", static_folder="static")
    app.config["SECRET_KEY"] = SECRET_KEY
    app.config["MAX_CONTENT_LENGTH"] = 16 * 1024 * 1024  # 16MB 上传限制
    
    # 初始化数据库
    init_db()
    
    # 注册默认管理员
    register_default_admin()
    
    # 注册错误处理
    register_error_handlers(app)
    
    # 注册路由
    register_routes(app)
    
    return app


def register_default_admin():
    """注册默认管理员"""
    conn = get_db()
    cursor = conn.cursor() if conn.__class__.__name__ == 'Connection' else conn
    result = cursor.execute(
        "SELECT id FROM users WHERE username = ?",
        ("admin",)
    ).fetchone()
    
    if not result:
        # 默认管理员密码 admin/Admin@123
        from services.auth_service import hash_password
        cursor.execute(
            """
            INSERT INTO users (username, password_hash, display_name, role, email, is_active)
            VALUES (?, ?, ?, ?, ?, 1)
            """,
            ("admin", hash_password("Admin@123"), "系统管理员", "admin", "admin@ipam.local")
        )
        conn.commit()
        logger.info("默认管理员 admin/Admin@123 已创建")
    conn.close()


def register_error_handlers(app):
    """注册错误处理"""
    @app.errorhandler(404)
    def not_found(error):
        return jsonify({"ok": False, "message": "404 未找到请求的资源"}), 404
    
    @app.errorhandler(500)
    def internal_error(error):
        logger.error(f"服务器内部错误: {error}")
        return jsonify({"ok": False, "message": "服务器内部错误"}), 500


def login_required(func):
    """登录装饰器"""
    @wraps(func)
    def wrapper(*args, **kwargs):
        user = session.get("user")
        if not user:
            return jsonify({"ok": False, "message": "请先登录"}), 401
        return func(*args, **kwargs)
    return wrapper


def permission_required(permission: str):
    """权限装饰器"""
    def decorator(func):
        @wraps(func)
        @login_required
        def wrapper(*args, **kwargs):
            user = session.get("user")
            if not has_permission(user["id"], permission):
                return jsonify({"ok": False, "message": "权限不足"}), 403
            return func(*args, **kwargs)
        return wrapper
    return decorator


def register_routes(app):
    """注册所有路由"""
    
    # ==================== 页面路由 ====================
    
    @app.route("/")
    @login_required
    def index_page():
        """仪表盘页面"""
        return render_template("index.html", user=session.get("user"))
    
    @app.route("/login")
    def login_page():
        """登录页面"""
        if session.get("user"):
            return redirect(url_for("index_page"))
        return render_template("login.html", user=None)
    
    @app.route("/logout", methods=["POST"])
    def logout_page():
        """退出登录"""
        session.clear()
        return redirect(url_for("login_page"))
    
    @app.route("/switches")
    @login_required
    def switches_page():
        """交换机管理页面"""
        return render_template("switches.html", user=session.get("user"), switches=get_switches())
    
    @app.route("/switches/<int:switch_id>")
    @login_required
    def switch_detail_page(switch_id: int):
        """交换机详情页面"""
        switch = get_switch_by_id(switch_id)
        if not switch:
            abort(404)
        bindings = get_bindings_by_switch(switch_id)
        return render_template("switch_detail.html", user=session.get("user"), switch=switch, bindings=bindings)
    
    @app.route("/bindings")
    @login_required
    def bindings_page():
        """IP-MAC 绑定管理页面"""
        return render_template("bindings.html", user=session.get("user"))
    
