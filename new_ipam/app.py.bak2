    @app.route("/api/bindings/batch-delete", methods=["POST"])
    @login_required
    @permission_required("binding:delete")
    def api_batch_delete_bindings():
        """批量删除绑定"""
        data = request.get_json() or request.form
        ids = data.get("ids", [])
        if not ids:
            return jsonify({"ok": False, "message": "请选择要删除的记录"}), 400
        
        deleted = 0
        for binding_id in ids:
            ok, msg = delete_binding(binding_id)
            if ok:
                deleted += 1
        
        return jsonify({"ok": True, "message": f"已删除 {deleted} 条记录", "deleted": deleted})
    
